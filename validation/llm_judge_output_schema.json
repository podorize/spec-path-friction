{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "classification",
    "confidence",
    "evidence_quote",
    "rationale"
  ],
  "properties": {
    "classification": {
      "type": "string",
      "enum": [
        "confirmed_exists",
        "confirmed_missing_problematic",
        "expected_absence_create",
        "expected_absence_move_or_delete",
        "non_file_reference",
        "ambiguous_reference",
        "inaccessible_or_invalid"
      ]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "evidence_quote": {
      "type": "string",
      "maxLength": 160
    },
    "rationale": {
      "type": "string"
    }
  }
}
